{
  "name": "paseo-shared-stack",
  "private": true,
  "version": "0.1.0",
  "description": "Queue agents from several Paseo daemons on one machine for one shared running dev stack. The agent at the front of the queue gets its working tree synced onto the stack; it releases the stack or times out, and the next agent gets it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-01/maxs-paseo-plugins.git",
    "directory": "shared-stack"
  },
  "keywords": ["paseo", "paseo-plugin"],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "README.md",
    "OVERVIEW.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  }
}
