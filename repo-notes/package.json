{
  "name": "paseo-repo-notes",
  "version": "0.1.1",
  "description": "Give every Paseo agent your own notes for its repo, kept out of the repo and synced across daemons.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-01/maxs-paseo-plugins.git",
    "directory": "repo-notes"
  },
  "keywords": [
    "paseo",
    "paseo-plugin"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test-support.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@getpaseo/client": "0.9.2",
    "@getpaseo/plugin": "0.9.2",
    "@getpaseo/protocol": "0.9.2",
    "@types/node": "^20.9.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.2"
  }
}
