{
  "name": "paseo-usage-pacer",
  "version": "0.3.0",
  "description": "Stop Claude and Codex agents before they use up a subscription's usage limits, and pace work across the week.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwell-01/maxs-paseo-plugins.git",
    "directory": "usage-pacer"
  },
  "keywords": [
    "paseo",
    "paseo-plugin"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test-support.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "embed:guard": "node scripts/embed-guard.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python3 -m unittest discover -s guard -p 'test_*.py'"
  },
  "devDependencies": {
    "@getpaseo/client": "0.13.2",
    "@getpaseo/plugin": "0.13.2",
    "@getpaseo/protocol": "0.13.2",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^20.9.0",
    "@types/react": "~19.1.0",
    "react": "~19.1.0",
    "react-native": "^0.81.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
